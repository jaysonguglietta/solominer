 	if (!ret) {
 		// don't fail = disconnect stratum on unknown (and optional?) methods
 		if (opt_debug) applog(LOG_WARNING, "unknown stratum method %s!", method);
 		ret = stratum_unknown_method(sctx, id);
 	}

+	} while (written < 0 && errno == EINTR);
+	if (written < 0 && errno == EPIPE && consume_sigpipe)
+		(void)sigwait(&blocked, &received);
+	(void)pthread_sigmask(SIG_SETMASK, &previous, NULL);

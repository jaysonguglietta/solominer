+static inline float linux_cputemp(int core)
+{
+	glob_t names = {0};
+	float maximum = 0.0;
+	size_t i;
+	(void)core;
+
+	/* hwmon numbers change across boots. Only recognized CPU devices are
+	 * eligible, so an unrelated NVMe/board sensor cannot satisfy the cutoff.
+	 * Use the hottest package/core reading, not the first available sensor. */
+	if (glob(CPUMINER_HWMON_ROOT "/hwmon*/name", 0, NULL, &names)) {
+		globfree(&names);
+		return 0.0;
+	}
+	for (i = 0; i < names.gl_pathc; i++) {
+		const char *name_path = names.gl_pathv[i];
+		char name[64], *pattern;
+		FILE *fd = fopen(name_path, "r");
+		glob_t inputs = {0};
+		size_t j, prefix_len;
+
+		if (!fd)
+			continue;
+		if (!fgets(name, sizeof(name), fd)) {
+			fclose(fd);
+			continue;
+		}
+		fclose(fd);
+		name[strcspn(name, "\r\n")] = '\0';
+		if (!linux_cpu_sensor_name(name))
+			continue;
+		prefix_len = strlen(name_path) - strlen("name");
+		pattern = (char *)malloc(prefix_len + sizeof("temp*_input"));
+		if (!pattern)
+			continue;
+		memcpy(pattern, name_path, prefix_len);
+		strcpy(pattern + prefix_len, "temp*_input");
+		if (!glob(pattern, 0, NULL, &inputs)) {
+			for (j = 0; j < inputs.gl_pathc; j++) {
+				float reading = linux_cpu_sensor_temperature(inputs.gl_pathv[j]);
+				if (reading > maximum)
+					maximum = reading;
+			}
+		}
+		globfree(&inputs);
+		free(pattern);
+	}
+	globfree(&names);
+	/* Zero keeps the upstream no-sensor convention. The wrapper doctor and
+	 * health checks must report that a thermal cutoff is unavailable. */
+	return maximum;
 }
 
 

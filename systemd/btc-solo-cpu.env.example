# SoloMiner configuration. Do not source this file as a shell script.
# The installer preserves an existing POOL, WALLET, WORKER and THREADS.
# Replace WALLET with a checksum-valid mainnet Bitcoin receive address.
POOL=stratum+tcp://pool.nerdminer.io:3333
WALLET=bc1qreplace_with_your_wallet_address
WORKER=fedora1
THREADS=2

# 100% is one logical CPU worth of time, shared across THREADS.
CPU_QUOTA=100%
MEMORY_MAX=256M
TASKS_MAX=64
# Degrees Celsius; a working CPU sensor is required for the cutoff.
MAX_TEMP=75
NO_REDIRECT=true
RETRY_PAUSE=30
HEALTH_TIMEOUT=900
# Legacy pools use plaintext. Set false when using a verified TLS endpoint.
ALLOW_INSECURE_POOL=true
# Optional comma-separated, provider-verified alternatives; never changes WALLET.
FALLBACK_POOLS=
